# Frontend environment template.
# Copy to .env.local (which is git-ignored) and restart `npm run dev`.

# true  = build reports in the browser (no backend needed)
# false = send requests to the FastAPI backend below
NEXT_PUBLIC_USE_MOCK=true

# Base URL of the FastAPI backend (only used when USE_MOCK is false)
NEXT_PUBLIC_API_URL=http://localhost:8000
